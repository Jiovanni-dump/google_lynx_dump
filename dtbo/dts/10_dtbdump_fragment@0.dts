	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-0;

			touchscreen@0 {
				status = "ok";
				reg = <0x00>;
				pinctrl-names = "ts_active\0ts_suspend";
				pinctrl-0 = <0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f>;
				pinctrl-1 = <0x10 0x11>;
				vdd-supply = <0x12>;
				avdd-supply = <0x13>;
				compatible = "goodix,nottingham";
				spi-max-frequency = <0x989680>;
				goodix,irq-gpio = <0xffffffff 0x00 0x00>;
				goodix,reset-gpio = <0xffffffff 0x02 0x00>;
				goodix,avdd-name = "avdd";
