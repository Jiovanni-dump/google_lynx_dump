				odpm {
					chip-name = "S2MPG13";
					sample-rate-uhz = <0x7735940>;
					sample-rate-external-uhz = <0x1dcd650>;
					max-refresh-time-ms = <0x6ddd00>;

					channels {

						channel@0 {
							rail-name = "VSEN_C4";
							channel_enabled;
						};

						channel@1 {
							rail-name = "VSEN_C5";
							channel_enabled;
						};

						channel@2 {
							rail-name = "VSEN_C6";
							channel_enabled;
						};

						channel@3 {
							rail-name = "BUCK1S";
							channel_enabled;
						};

						channel@4 {
							rail-name = "BUCK2S";
							channel_enabled;
						};

						channel@5 {
