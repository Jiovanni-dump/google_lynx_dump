	fragment@23 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpg12mfd@1f {
				compatible = "samsung,s2mpg12mfd";
				acpm-ipc-channel = <0x02>;
				s2mpg12,wakeup = "enabled";
				reg = <0x1f>;
				interrupts = <0x00 0x48 0x04>;
				interrupt-parent = <0xffffffff>;
				pinctrl-names = "default";
				pinctrl-0 = <0x1c 0x1d>;
				gpios = <0xffffffff 0x00 0x00 0xffffffff 0x01 0x00 0xffffffff 0x02 0x00 0xffffffff 0x03 0x00 0xffffffff 0x04 0x00 0xffffffff 0x01 0x00 0xffffffff 0x03 0x00>;
				#thermal-sensor-cells = <0x01>;
				smpl_warn_en = <0x01>;
				smpl_warn_vth = <0x03>;
				smpl_warn_hys = <0x01>;
				b2_ocp_warn_en = <0x01>;
				b2_ocp_warn_cnt = <0x00>;
				b2_ocp_warn_dvs_mask = <0x00>;
				b2_ocp_warn_lvl = <0x00>;
				b3_ocp_warn_en = <0x01>;
				b3_ocp_warn_cnt = <0x00>;
				b3_ocp_warn_dvs_mask = <0x00>;
				b3_ocp_warn_lvl = <0x00>;
				b10_ocp_warn_en = <0x01>;
				b10_ocp_warn_cnt = <0x00>;
				b10_ocp_warn_dvs_mask = <0x00>;
				b10_ocp_warn_lvl = <0x00>;
				b2_soft_ocp_warn_en = <0x00>;
				b2_soft_ocp_warn_cnt = <0x00>;
				b2_soft_ocp_warn_dvs_mask = <0x00>;
				b2_soft_ocp_warn_lvl = <0x14>;
				b3_soft_ocp_warn_en = <0x00>;
				b3_soft_ocp_warn_cnt = <0x00>;
				b3_soft_ocp_warn_dvs_mask = <0x00>;
				b3_soft_ocp_warn_lvl = <0x00>;
				b10_soft_ocp_warn_en = <0x00>;
				b10_soft_ocp_warn_cnt = <0x00>;
				b10_soft_ocp_warn_dvs_mask = <0x00>;
				b10_soft_ocp_warn_lvl = <0x00>;
				buck_ocp_ctrl1 = <0xbb>;
				buck_ocp_ctrl2 = <0xbb>;
				buck_ocp_ctrl3 = <0xbb>;
				buck_ocp_ctrl4 = <0xbb>;
				buck_ocp_ctrl5 = <0xbb>;
				wtsr_en = "enabled";
				coldrst_en = "disabled";
				smpl_en = "disabled";
				wtsr_timer_val = <0x03>;
				coldrst_timer_val = <0x03>;
				smpl_timer_val = <0x04>;
				sub_smpl_en = "disabled";
				check_jigon = <0x00>;
				init_time,sec = <0x00>;
				init_time,min = <0x00>;
				init_time,hour = <0x0c>;
				init_time,mday = <0x01>;
				init_time,mon = <0x00>;
				init_time,year = <0x78>;
				init_time,wday = <0x03>;
				sel_vgpio = <0xc2 0x0b 0x22 0xa2 0x2d 0x2f 0x55 0x55 0x0b 0x7d 0x32 0x3c 0x80 0x80>;
				phandle = <0x21>;

				s2mpg12-keys {

					button@1 {
						label = "pmic-keys: KEY_POWER";
						linux,code = <0x74>;
						wakeup = <0x01>;
					};
				};

				regulators {

					BUCK1M {
						regulator-name = "S2MPG12_BUCK1";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x01>;
						schematic-name = "S1M_VDD_MIF";
						subsys-name = "MIF";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x01>;
					};

					BUCK2M {
						regulator-name = "S2MPG12_BUCK2";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x02>;
						schematic-name = "S2M_VDD_CPUCL2";
						subsys-name = "CPU(BIG)";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x02>;
						odpm_disable_in_sleep;
					};

					BUCK3M {
						regulator-name = "S2MPG12_BUCK3";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x03>;
						schematic-name = "S3M_VDD_CPUCL1";
						subsys-name = "CPU(MID)";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x04>;
						odpm_disable_in_sleep;
					};

					BUCK4M {
						regulator-name = "S2MPG12_BUCK4";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x04>;
						schematic-name = "S4M_VDD_CPUCL0";
						subsys-name = "CPU(LITTLE)";
