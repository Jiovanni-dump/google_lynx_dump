					BUCK1S {
						regulator-name = "S2MPG13_BUCK1";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x01>;
						schematic-name = "S1S_VDD_CAM";
						subsys-name = "Multimedia";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x01>;
						odpm_disable_in_sleep;
					};

					BUCK2S {
						regulator-name = "S2MPG13_BUCK2";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x02>;
						schematic-name = "S2S_VDD_G3D";
						subsys-name = "GPU";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x02>;
						odpm_disable_in_sleep;
					};

					BUCK3S {
						regulator-name = "S2MPG13_BUCK3";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x03>;
						schematic-name = "S3S_LLDO1";
						subsys-name = "LDO";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x04>;
					};

					BUCK4S {
						regulator-name = "S2MPG13_BUCK4";
						regulator-min-microvolt = <0x6ddd0>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x03>;
						channel-mux-selection = <0x04>;
						schematic-name = "S4S_VDD2H_MEM";
						subsys-name = "DDR";
						buck_rail;
						channel-en-byte-offset = <0x00>;
						channel-en-index = <0x08>;
					};

					BUCK5S {
						regulator-name = "S2MPG13_BUCK5";
						regulator-min-microvolt = <0x61a80>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						regulator-initial-mode = <0x01>;
						channel-mux-selection = <0x05>;
						schematic-name = "S5S_VDDQ_MEM";
						subsys-name = "DDR";
