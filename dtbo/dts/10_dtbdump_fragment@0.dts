	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {

			ts-reset {
				samsung,pins = "gpp23-2";
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
				phandle = <0x0a>;
			};

			ts_spi_bus_active {
				samsung,pins = "gpp20-0\0gpp20-1";
				samsung,pin-function = <0x03>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x0d>;
			};

			ts_spi_miso_active {
