							rail-name = "LDO7S";
							channel_enabled;
						};

						channel@10 {
							rail-name = "BUCK6S";
							channel_enabled;
						};

						channel@11 {
							rail-name = "BUCK7S";
							channel_enabled;
						};
					};

					rails {
						use-regulators-as-rails;

						VSEN_C4 {
							external_rail;
							channel-en-index = <0x01>;
							channel-mux-selection = <0x5c>;
							shunt-res-uohms = <0x2710>;
							schematic-name = "VSYS_PWR_DISPLAY";
							subsys-name = "Display";
						};

						VSEN_C5 {
							external_rail;
							channel-en-index = <0x02>;
							channel-mux-selection = <0x5d>;
							shunt-res-uohms = <0x2710>;
							schematic-name = "VSYS_PWR_WLAN_BT";
							subsys-name = "WLAN-BT";
						};

						VSEN_C6 {
							external_rail;
							channel-en-index = <0x04>;
							channel-mux-selection = <0x5e>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_CAM";
							subsys-name = "Multimedia";
						};
					};
				};

				s2mpg13_gpio {
					gpio-controller;
					#gpio-cells = <0x02>;
					ngpios = <0x08>;
					gpio-ranges = <0x20 0x00 0x00 0x08>;
					phandle = <0x5b>;
				};

				s2mpg13_pinctrl {
					phandle = <0x20>;
				};
			};
		};
