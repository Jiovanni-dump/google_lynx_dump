				goog,display-resolution = <0x4380960>;
				goog,channel-num = <0x100022>;
				goog,tbn-enabled;
				phandle = <0x76>;

				controller-data {
					samsung,spi-feedback-delay = <0x00>;
					samsung,spi-chip-select-mode = <0x01>;
					cs-clock-delay = <0x01>;
				};
			};
		};
	};

	fragment@17 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			max77759tcpc@25 {
				status = "okay";
				compatible = "max77759tcpc";
				reg = <0x25>;
				pinctrl-names = "default";
				pinctrl-0 = <0x14>;
				interrupt-parent = <0xffffffff>;
				usbpd,usbpd_int = <0xffffffff 0x07 0x01>;
