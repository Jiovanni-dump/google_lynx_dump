/dts-v1/;

/ {
	board_id = <0x30506>;
	board_rev = <0x10000>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			codec {
				sound-dai = <0x01 0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			clks {

				sys {

					sys@cs40l26_codec {
						comp = <0x01>;
						src = "BCLK";
						id = <0x00>;
						srcid = <0x00>;
						in_mul = <0x01>;
						out_mul = <0x01>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			hapt-amp-irq {
				samsung,pins = "gpa8-1";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				phandle = <0x02>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			hapt-amp-rst {
				samsung,pins = "gpp24-3";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
				phandle = <0x03>;
			};

			hapt-amp-trig {
				samsung,pins = "gpp24-2";
				samsung,pin-function = <0x01>;
				samsung,pin-pud = <0x00>;
				samsung,pin-con-pdn = <0x03>;
				samsung,pin-pud-pdn = <0x00>;
				phandle = <0x04>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0xffffffff>;
			clock-frequency = <0x61a80>;

			cs40l26a@43 {
				compatible = "cirrus,cs40l26a";
				reg = <0x43>;
				input-device-name = "cs40l26_input";
				pinctrl-names = "default";
				pinctrl-0 = <0x02 0x03 0x04>;
