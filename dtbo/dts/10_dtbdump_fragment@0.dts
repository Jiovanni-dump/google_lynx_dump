				odpm {
					chip-name = "S2MPG12";
					sample-rate-uhz = <0x7735940>;
					sample-rate-external-uhz = <0x1dcd650>;
					max-refresh-time-ms = <0x6ddd00>;

					channels {

						channel@0 {
							rail-name = "VSEN_C1";
							channel_enabled;
						};

						channel@1 {
							rail-name = "VSEN_C2";
							channel_enabled;
						};

						channel@2 {
							rail-name = "VSEN_C3";
							channel_enabled;
						};

						channel@3 {
							rail-name = "BUCK1M";
							channel_enabled;
						};

						channel@4 {
							rail-name = "BUCK2M";
							channel_enabled;
						};

						channel@5 {
							rail-name = "BUCK3M";
							channel_enabled;
						};

						channel@6 {
							rail-name = "BUCK4M";
							channel_enabled;
						};

						channel@7 {
							rail-name = "BUCK5M";
							channel_enabled;
						};

						channel@8 {
							rail-name = "BUCK8M";
							channel_enabled;
						};

						channel@9 {
							rail-name = "LDO15M";
							channel_enabled;
						};

						channel@10 {
							rail-name = "BUCK10M";
							channel_enabled;
						};

						channel@11 {
							rail-name = "BUCK6M";
							channel_enabled;
						};
					};

					rails {
						use-regulators-as-rails;

						VSEN_C1 {
							external_rail;
							channel-en-index = <0x01>;
							channel-mux-selection = <0x5c>;
							shunt-res-uohms = <0x2710>;
							schematic-name = "VSYS_PWR_MMWAVE";
							subsys-name = "Cellular";
						};

						VSEN_C2 {
							external_rail;
							channel-en-index = <0x02>;
							channel-mux-selection = <0x5d>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_MODEM";
							subsys-name = "Modem";
						};

						VSEN_C3 {
							external_rail;
							channel-en-index = <0x04>;
							channel-mux-selection = <0x5e>;
							shunt-res-uohms = <0x1388>;
							schematic-name = "VSYS_PWR_RFFE";
							subsys-name = "Cellular";
						};
					};
				};

				s2mpg12_gpio {
					gpio-controller;
					#gpio-cells = <0x02>;
					ngpios = <0x06>;
					gpio-ranges = <0x1e 0x00 0x00 0x06>;
					phandle = <0x39>;
				};

				s2mpg12_pinctrl {
					phandle = <0x1e>;
				};
			};
		};
	};

	fragment@24 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			s2mpg13mfd@2f {
				compatible = "samsung,s2mpg13mfd";
				acpm-ipc-channel = <0x02>;
				s2mpg13,wakeup = "enabled";
				reg = <0x2f>;
				interrupts = <0x01 0x00 0x00 0x01 0x00 0x01>;
				interrupt-parent = <0xffffffff>;
				pinctrl-names = "default";
				pinctrl-0 = <0x1f>;
				gpios = <0xffffffff 0x00 0x00 0xffffffff 0x02 0x00>;
				#thermal-sensor-cells = <0x01>;
				b2_ocp_warn_en = <0x01>;
				b2_ocp_warn_cnt = <0x00>;
				b2_ocp_warn_dvs_mask = <0x00>;
				b2_ocp_warn_lvl = <0x00>;
				b2_soft_ocp_warn_en = <0x00>;
				b2_soft_ocp_warn_cnt = <0x00>;
				b2_soft_ocp_warn_dvs_mask = <0x00>;
				b2_soft_ocp_warn_lvl = <0x00>;
				buck_ocp_ctrl1 = <0xbb>;
				buck_ocp_ctrl2 = <0xbb>;
				buck_ocp_ctrl3 = <0xbb>;
				buck_ocp_ctrl4 = <0xbb>;
				buck_ocp_ctrl5 = <0xbb>;
				buck_ocp_ctrl6 = <0xbb>;
				buck_ocp_ctrl7 = <0x0b>;
