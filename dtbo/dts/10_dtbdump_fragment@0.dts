				cirrus,bst-expl-mode-disable;
				cirrus,bst-ipk-microamp = <0x2625a0>;
				cirrus,bst-ctl-microvolt = <0x989680>;
				cirrus,f0-default = <0x2a8000>;
				cirrus,redc-default = <0x68000>;
				cirrus,pm-active-timeout-ms = <0x05>;
				status = "okay";

				cs40l26_codec@snd {
					#sound-dai-cells = <0x01>;
					compatible = "cs40l26-codec";
					status = "okay";
					phandle = <0x01>;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0xffffffff 0xffffffff>;
			dma-mode;
			dmas = <0xffffffff 0x0a 0xffffffff 0x0b>;
			swap-mode = <0x01>;

			bcm4775@0 {
				compatible = "ssp-spi,bcm4775";
				reg = <0x00>;
				spi-max-frequency = <0x18cba80>;
				spi-cpol;
				spi-cpha;
				pinctrl-names = "default";
				pinctrl-0 = <0x05 0x06 0x07 0x08>;
				mcu-req-gpios = <0xffffffff 0x03 0x00>;
