	fragment@25 {
		target = <0xffffffff>;

		__overlay__ {
			main-pmic = <0x21>;
			sub-pmic = <0x22>;
			acpm-ipc-channel = <0x02>;
		};
	};

	fragment@26 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@27 {
		target = <0xffffffff>;

		__overlay__ {

			key-volup {
				samsung,pins = "gpa8-5";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x24>;
			};
		};
	};

	fragment@28 {
		target = <0xffffffff>;

		__overlay__ {

			key-power {
				samsung,pins = "gpa10-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x03>;
				samsung,pin-drv = <0x00>;
				phandle = <0x25>;
			};

			key-voldown {
				samsung,pins = "gpa10-1";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x03>;
				samsung,pin-drv = <0x00>;
				phandle = <0x23>;
			};
		};
	};

	fragment@29 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x23 0x24 0x25>;

			button@1 {
				label = "gpio-keys: KEY_VOLUMEDOWN";
				linux,code = <0x72>;
				gpios = <0xffffffff 0x01 0x0f>;
				wakeup-source;
			};

			button@2 {
				label = "gpio-keys: KEY_VOLUMEUP";
				linux,code = <0x73>;
				gpios = <0xffffffff 0x05 0x0f>;
				wakeup-source;
			};
		};
	};

	fragment@30 {
		target = <0xffffffff>;

		__overlay__ {
			adj-sof-accuracy = <0x01>;
			samsung,no-extra-delay;
			usb_host_device_timeout = <0x7ff>;
			extcon = <0x19>;
			u1u2_exitfail_quirk;
			ux_exit_in_px_quirk;
			elastic_buf_mode_quirk;
			xhci_l2_support = <0x01>;

			dwc3 {
				dr_mode = "peripheral";
				maximum-speed = "super-speed-plus";
				usb-psy-name = "usb";
				snps,quirk-frame-length-adjustment = <0x20>;
				snps,has-lpm-erratum;
				snps,lpm-nyet-threshold = <0x00>;
				snps,usb2-gadget-lpm-disable;
				snps,dis-u2-freeclk-exists-quirk;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				xhci_l2_support = <0x01>;
			};
		};
	};

